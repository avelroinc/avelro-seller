{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiKey",
    "apiSecret"
  ],
  "properties": {
    "apiKey": {
      "type": "string",
      "title": "apiKey",
      "minLength": 1
    },
    "apiSecret": {
      "type": "string",
      "title": "apiSecret",
      "minLength": 1,
      "writeOnly": true
    }
  }
}
