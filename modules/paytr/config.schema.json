{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "merchantId",
    "merchantKey",
    "merchantSalt"
  ],
  "properties": {
    "merchantId": {
      "type": "string",
      "title": "merchantId",
      "minLength": 1
    },
    "merchantKey": {
      "type": "string",
      "title": "merchantKey",
      "minLength": 1,
      "writeOnly": true
    },
    "merchantSalt": {
      "type": "string",
      "title": "merchantSalt",
      "minLength": 1,
      "writeOnly": true
    }
  }
}
