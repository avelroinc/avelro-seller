{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "clientId",
    "clientSecret"
  ],
  "properties": {
    "clientId": {
      "type": "string",
      "title": "clientId",
      "minLength": 1
    },
    "clientSecret": {
      "type": "string",
      "title": "clientSecret",
      "minLength": 1,
      "writeOnly": true
    }
  }
}
